# Kopyalayın: cp .env.example .env  (.env repoya girmez)
# Üretimde DATABASE_URL, AUTH_SECRET, FIELD_ENCRYPTION_KEY ve https NEXT_PUBLIC_SITE_URL
# eksikse sunucu BAŞLAMAZ (apps/web/src/instrumentation.ts).

# --- Zorunlu ---
DATABASE_URL="postgresql://avrupadasat:avrupadasat@localhost:5432/avrupadasat?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# En az 32 karakter: openssl rand -base64 48
AUTH_SECRET=""
# Vergi no, IBAN, TOTP sırrı, alıcı adresi şifrelemesi — 32 bayt: openssl rand -base64 32
# DİKKAT: değiştirilirse mevcut şifreli veriler okunamaz (bkz. docs/RUNBOOK.md)
FIELD_ENCRYPTION_KEY=""
# Rotasyon: FIELD_ENCRYPTION_KEYS="2:<yeni>,1:<eski>" (ilk sıradaki etkin) → pnpm db:rotate-keys → eski anahtarı kaldırın
FIELD_ENCRYPTION_KEYS=""
# Zamanlanmış işler (/api/cron/*) — en az 32 karakter
CRON_SECRET=""

# --- Depolama ve tarama ---
# local (varsayılan; public dizini dışında) veya s3 (AB bölgesi S3/R2/MinIO)
STORAGE_DRIVER="local"
STORAGE_DIR=""
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# ClamAV (clamd) — boşsa tarama atlanır ve belge "Taranmadı" olarak işaretlenir
CLAMAV_HOST=""
CLAMAV_PORT="3310"

# --- Ölçüm (yalnız çerez onayıyla yüklenir) ---
GTM_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Entegrasyonlar: boşsa "mock" (demo) modunda çalışır ---
INTEGRATIONS_MODE="mock"
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
# smtp(s)://kullanici:sifre@sunucu:587 — boşsa mock (üretim+live modda boşsa gönderim hata verir)
SMTP_URL=""
MAIL_FROM="Avrupadasat <merhaba@avrupadasat.com>"
# Ekip bildirimleri (virgülle birden fazla)
OPS_EMAIL=""

# --- Yapay zekâ (boşsa işaretli demo sağlayıcı) ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# --- Yalnız geliştirme ---
SEED_PASSWORD="Demo sifre 2026"

# Sandbox uç noktaları (Amazon/eBay): 1
INTEGRATIONS_SANDBOX=
# Anlık bildirim: mock | live (boşsa INTEGRATIONS_MODE izlenir)
PUSH_MODE=
EXPO_ACCESS_TOKEN=

# İzleme: /api/health/deep için (boşsa CRON_SECRET)
HEALTH_TOKEN=
