# Kopyalayın: cp .env.example .env  (.env repoya girmez)

# Veritabanı (yerelde: pnpm db:up)
DATABASE_URL="postgresql://avrupadasat:avrupadasat@localhost:5432/avrupadasat?schema=public"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Oturum (en az 32 karakter rastgele değer: openssl rand -base64 32)
AUTH_SECRET=""

# Hassas alan şifreleme anahtarı (vergi no, IBAN) — 32 bayt base64
FIELD_ENCRYPTION_KEY=""

# Dış entegrasyonlar: boş bırakılırsa "mock" modunda çalışır
INTEGRATIONS_MODE="mock"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
GTM_ID=""
META_PIXEL_ID=""
META_CAPI_TOKEN=""
AMAZON_SP_API_CLIENT_ID=""
AMAZON_SP_API_CLIENT_SECRET=""
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
SMTP_URL=""
