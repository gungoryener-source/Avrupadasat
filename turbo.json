{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "DATABASE_URL"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "NEXT_OUTPUT"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^generate"]
    },
    "typecheck": {
      "dependsOn": ["^generate"]
    },
    "test": {
      "dependsOn": ["^generate"],
      "passThroughEnv": [
        "AUTH_SECRET",
        "FIELD_ENCRYPTION_KEY",
        "FIELD_ENCRYPTION_KEYS",
        "CRON_SECRET",
        "HEALTH_TOKEN",
        "CI"
      ]
    }
  }
}
