// Avrupadasat — veri modeli (Aşama 0 taslağı)
// Kural: Müşteri firmaya ait her kayıtta `tenantId` vardır ve sorgular
// `forTenant()` istemcisiyle yapılır (bkz. src/tenant.ts). İzolasyon testleri zorunludur.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  OPS
  FINANCE
  SALES
  PARTNER
}

enum ClientRole {
  CLIENT_OWNER
  CLIENT_USER
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CLOSED
}

enum PackageCode {
  BASLANGIC
  OPERASYON
  PAZARA_GIRIS
}

enum LeadStatus {
  NEW
  REPORT_IN_PROGRESS
  REPORT_SENT
  QUOTED
  WON
  LOST
}

enum RegistrationStep {
  VEKALETNAME
  APOSTIL
  NOTER
  TICARET_SICILI
  VERGI_NO
  UST_ID
  EORI
  LUCID
}

enum StepStatus {
  BEKLIYOR
  SURUYOR
  TAMAM
  SORUN
}

enum ShipmentStage {
  FABRIKA
  TR_CIKIS
  AB_GIRIS
  GUMRUK
  DEPO_KABUL
}

/// Müşteri firma (kiracı)
model Tenant {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  city         String?
  status       TenantStatus @default(ONBOARDING)
  packageCode  PackageCode?
  /// Depoda kullanılan palet (depo bildirir; faturalama günlük anlık görüntülerden ortalar)
  palletsInUse Int          @default(0)
  /// Fatura KDV oranı (%). TODO(verify): müşteri tipine göre (Alman şirketi / yurt dışı B2B) vergi danışmanıyla
  vatRatePct   Int          @default(19)
  /// AES-256-GCM ile şifreli (src/crypto.ts)
  taxNumberEnc String?
  ibanEnc      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships  Membership[]
  partners     PartnerAssignment[]
  shipments    Shipment[]
  stockItems   StockItem[]
  documents    Document[]
  registration RegistrationTask[]
  leads        Lead[]
  quotes       Quote[]
  contracts    Contract[]
  contacts     TenantContact[]
  orders       Order[]
  invoices     Invoice[]
  connections  MarketplaceConnection[]
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String
  /// Argon2id hash (Aşama 1)
  passwordHash       String?
  /// TOTP sırrı, AES-256-GCM ile şifreli
  twoFactorSecretEnc String?
  twoFactorEnabledAt DateTime?
  /// Son kabul edilen TOTP zaman adımı (aynı kodun tekrar kullanımını engeller)
  lastTotpStep       Int?
  failedLogins       Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Ekip rolü; müşteri kullanıcılarında boş, rolü Membership belirler
  staffRole          StaffRole?
  disabledAt         DateTime?
  createdAt          DateTime   @default(now())

  memberships Membership[]
  partnerOf   PartnerAssignment[]
  sessions    Session[]
  tokens      AuthToken[]
}

model Session {
  id              String   @id @default(cuid())
  /// SHA-256(token); ham token yalnız çerezde
  tokenHash       String   @unique
  userId          String
  twoFactorPassed Boolean  @default(false)
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Basit sabit pencereli hız sınırı (çoklu sunucuda da çalışır)
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CompanyForm {
  UG
  GMBH
  NONE
}

model Quote {
  id               String      @id @default(cuid())
  number           String      @unique
  leadId           String?
  tenantId         String?
  packageCode      PackageCode
  companyForm      CompanyForm @default(UG)
  /// [{ code, description, quantity, unitCents, recurring }]
  lines            Json
  oneTimeCents     Int
  monthlyCents     Int
  status           QuoteStatus @default(DRAFT)
  publicTokenHash  String?     @unique
  priceListVersion String
  validUntil       DateTime
  sentAt           DateTime?
  acceptedAt       DateTime?
  acceptedByName   String?
  acceptedIp       String?
  createdById      String?
  createdAt        DateTime    @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id])
  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  contract Contract?

  @@index([status, createdAt])
}

/// Çevrimiçi teklif onayı = hizmet sözleşmesi kaydı
model Contract {
  id           String   @id @default(cuid())
  tenantId     String
  quoteId      String   @unique
  termsVersion String
  signerName   String
  signerEmail  String
  signerIp     String?
  signedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote  Quote  @relation(fields: [quoteId], references: [id])

  @@index([tenantId])
}

model TenantContact {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      ClientRole
  createdAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Partner (ör. depo) kullanıcısının hizmet verdiği firmalar
model PartnerAssignment {
  id       String @id @default(cuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

/// Ücretsiz uygunluk raporu / ön değerlendirme talebi
model Lead {
  id               String     @id @default(cuid())
  companyName      String
  email            String
  phone            String
  category         String
  status           LeadStatus @default(NEW)
  consentKvkk      Boolean
  marketingConsent Boolean    @default(false)
  attribution      Json       @default("{}")
  /// Müşteriye dönüşünce bağlanır
  tenantId         String?
  createdAt        DateTime   @default(now())

  notes  String?
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  quotes Quote[]

  @@index([status, createdAt])
}

model RegistrationTask {
  id        String           @id @default(cuid())
  tenantId  String
  step      RegistrationStep
  status    StepStatus       @default(BEKLIYOR)
  note      String?
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, step])
}

model Shipment {
  id         String        @id @default(cuid())
  tenantId   String
  reference  String
  stage      ShipmentStage @default(FABRIKA)
  pallets    Int           @default(0)
  cartons    Int           @default(0)
  origin     String?
  carrier    String?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events    ShipmentEvent[]
  lines     AsnLine[]
  documents Document[]

  @@unique([tenantId, reference])
  @@index([tenantId, stage])
}

model StockItem {
  id                String    @id @default(cuid())
  tenantId          String
  sku               String
  name              String
  ean               String?
  quantity          Int       @default(0)
  reserved          Int       @default(0)
  /// Almanca ürün içeriği onaylandı mı (Aşama 5'te içerik üretimiyle dolar)
  contentApprovedAt DateTime?
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
}

/// Transactional outbox: olaylar aynı işlemde yazılır, worker işler
model OutboxEvent {
  id             String    @id @default(cuid())
  type           String
  tenantId       String?
  payload        Json
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  entity      String
  entityId    String?
  meta        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Tarih aralıklı fiyat listesi (varsayılan: packages/core/src/pricing.ts)
model PriceList {
  id        String    @id @default(cuid())
  version   String    @unique
  validFrom DateTime
  validTo   DateTime?
  data      Json
  createdAt DateTime  @default(now())
}

/// Çerez onay kaydı (kanıt yükümlülüğü). Kişisel veri yok: IP yalnız günlük tuzlu hash.
model ConsentRecord {
  id        String   @id @default(cuid())
  analytics Boolean
  ads       Boolean
  version   String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ShipmentEvent {
  id          String        @id @default(cuid())
  tenantId    String
  shipmentId  String
  stage       ShipmentStage
  note        String?
  at          DateTime      @default(now())
  actorUserId String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, shipmentId, at])
}

/// ASN (gelen sevkiyat bildirimi) satırı
model AsnLine {
  id          String @id @default(cuid())
  tenantId    String
  shipmentId  String
  sku         String
  quantity    Int
  receivedQty Int?
  damagedQty  Int    @default(0)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sku])
  @@index([tenantId])
}

enum DocumentKind {
  TICARI_FATURA
  CEKI_LISTESI
  ATR
  CMR
  CE_BEYAN
  SIRKET
  DIGER
}

model Document {
  id           String       @id @default(cuid())
  tenantId     String
  shipmentId   String?
  kind         DocumentKind
  filename     String
  mime         String
  size         Int
  sha256       String
  /// Depolama anahtarı (rastgele; dosya adı içermez)
  storageKey   String       @unique
  scanStatus   String       @default("pending")
  uploadedById String?
  createdAt    DateTime     @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  sku         String
  delta       Int
  /// RECEIVE, ORDER, RETURN, ADJUST, DAMAGE
  reason      String
  refId       String?
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([tenantId, sku, createdAt])
}

enum SalesChannel {
  AMAZON
  EBAY
  WEBSHOP
  MANUAL
}

model MarketplaceConnection {
  id              String       @id @default(cuid())
  tenantId        String
  channel         SalesChannel
  /// mock | live
  mode            String       @default("mock")
  status          String       @default("ACTIVE")
  /// Pazaryeri kimlik bilgileri (şifreli JSON)
  credentialsEnc  String?
  /// Gizli olmayan hesap tanımı (Shopify mağaza alan adı, Amazon Seller ID) — webhook eşlemesi için
  externalAccount String?
  lastSyncAt      DateTime?
  createdAt       DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([channel, externalAccount])
}

enum OrderStatus {
  NEW
  ON_HOLD
  ALLOCATED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id         String       @id @default(cuid())
  tenantId   String
  channel    SalesChannel
  externalId String
  status     OrderStatus  @default(NEW)
  /// Alıcı adı + adres (kişisel veri): şifreli JSON
  shipToEnc  String
  country    String       @default("DE")
  itemsCents Int          @default(0)
  currency   String       @default("EUR")
  carrier    String?
  trackingNo String?
  holdReason String?
  orderedAt  DateTime
  shippedAt  DateTime?
  createdAt  DateTime     @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines      OrderLine[]
  workOrders WorkOrder[]
  returns    ReturnItem[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, orderedAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  tenantId       String
  orderId        String
  /// Pazaryerindeki kalem kimliği (Amazon OrderItemId) — kargo onayında gerekir
  externalLineId String?
  sku            String
  quantity       Int
  priceCents     Int     @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, sku])
}

enum WorkOrderType {
  PICK_PACK
  PRE_FBA
}

model WorkOrder {
  id            String        @id @default(cuid())
  tenantId      String
  orderId       String?
  type          WorkOrderType
  cartons       Int           @default(0)
  status        String        @default("OPEN")
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime      @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

enum ReturnCondition {
  SELLABLE
  REPACK
  DAMAGED
}

model ReturnItem {
  id          String           @id @default(cuid())
  tenantId    String
  orderId     String?
  sku         String
  quantity    Int
  reason      String?
  condition   ReturnCondition?
  status      String           @default("RECEIVED")
  processedAt DateTime?
  createdAt   DateTime         @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

/// Üçüncü taraf masrafları (noter, kargo, gümrük) — faturaya birebir yansır
model Disbursement {
  id          String   @id @default(cuid())
  tenantId    String
  description String
  amountCents Int
  incurredAt  DateTime
  invoiceId   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, incurredAt])
}

model StorageSnapshot {
  id       String   @id @default(cuid())
  tenantId String
  day      DateTime @db.Date
  pallets  Int

  @@unique([tenantId, day])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  number     String?       @unique
  period     String
  status     InvoiceStatus @default(DRAFT)
  /// [{ code, description, quantity, unitCents, totalCents }]
  lines      Json
  netCents   Int
  vatRatePct Int
  vatCents   Int
  grossCents Int
  issuedAt   DateTime?
  dueAt      DateTime?
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
}

enum MessageStatus {
  NEW
  DRAFTED
  SENT
  CLOSED
}

/// Pazaryeri alıcı mesajı. Yapay zekâ yalnız TASLAK üretir; gönderim insan onayıyla.
model CustomerMessage {
  id         String        @id @default(cuid())
  tenantId   String
  channel    SalesChannel
  externalId String
  orderRef   String?
  buyerName  String
  subject    String
  bodyDe     String
  bodyTr     String?
  draftDe    String?
  draftTr    String?
  status     MessageStatus @default(NEW)
  aiModel    String?
  sentAt     DateTime?
  sentById   String?
  receivedAt DateTime      @default(now())

  @@unique([tenantId, channel, externalId])
  @@index([tenantId, status, receivedAt])
}

/// Almanca ürün içeriği: Türkçe girdi → yapay zekâ taslağı → insan onayı
model ProductContent {
  id            String    @id @default(cuid())
  tenantId      String
  sku           String
  titleTr       String
  featuresTr    String
  titleDe       String?
  bulletsDe     String?
  descriptionDe String?
  status        String    @default("DRAFT")
  aiModel       String?
  approvedById  String?
  approvedAt    DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, sku])
}

/// Mobil uygulama erişim token'ı (yalnız hash saklanır)
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  name       String
  /// Expo anlık bildirim anahtarı (cihaz). Oturum silinince bildirim de durur.
  pushToken  String?   @unique
  lastUsedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Arka plan süreçlerinin son canlılık zamanı (izleme için; kişisel veri yok)
model SystemHeartbeat {
  name   String   @id
  seenAt DateTime
}
