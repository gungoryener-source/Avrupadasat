// Avrupadasat — veri modeli (Aşama 0 taslağı)
// Kural: Müşteri firmaya ait her kayıtta `tenantId` vardır ve sorgular
// `forTenant()` istemcisiyle yapılır (bkz. src/tenant.ts). İzolasyon testleri zorunludur.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  OPS
  FINANCE
  SALES
  PARTNER
}

enum ClientRole {
  CLIENT_OWNER
  CLIENT_USER
}

enum TenantStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CLOSED
}

enum PackageCode {
  BASLANGIC
  OPERASYON
  PAZARA_GIRIS
}

enum LeadStatus {
  NEW
  REPORT_IN_PROGRESS
  REPORT_SENT
  QUOTED
  WON
  LOST
}

enum RegistrationStep {
  VEKALETNAME
  APOSTIL
  NOTER
  TICARET_SICILI
  VERGI_NO
  UST_ID
  EORI
  LUCID
}

enum StepStatus {
  BEKLIYOR
  SURUYOR
  TAMAM
  SORUN
}

enum ShipmentStage {
  FABRIKA
  TR_CIKIS
  AB_GIRIS
  GUMRUK
  DEPO_KABUL
}

/// Müşteri firma (kiracı)
model Tenant {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  city          String?
  status        TenantStatus @default(ONBOARDING)
  packageCode   PackageCode?
  /// AES-256-GCM ile şifreli (src/crypto.ts)
  taxNumberEnc  String?
  ibanEnc       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships   Membership[]
  partners      PartnerAssignment[]
  shipments     Shipment[]
  stockItems    StockItem[]
  registration  RegistrationTask[]
  leads         Lead[]
  quotes        Quote[]
  contracts     Contract[]
  contacts      TenantContact[]
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  name             String
  /// Argon2id hash (Aşama 1)
  passwordHash     String?
  /// TOTP sırrı, AES-256-GCM ile şifreli
  twoFactorSecretEnc String?
  twoFactorEnabledAt DateTime?
  failedLogins     Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// Ekip rolü; müşteri kullanıcılarında boş, rolü Membership belirler
  staffRole        StaffRole?
  disabledAt       DateTime?
  createdAt        DateTime   @default(now())

  memberships      Membership[]
  partnerOf        PartnerAssignment[]
  sessions         Session[]
  tokens           AuthToken[]
}

model Session {
  id              String   @id @default(cuid())
  /// SHA-256(token); ham token yalnız çerezde
  tokenHash       String   @unique
  userId          String
  twoFactorPassed Boolean  @default(false)
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Basit sabit pencereli hız sınırı (çoklu sunucuda da çalışır)
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CompanyForm {
  UG
  GMBH
  NONE
}

model Quote {
  id             String      @id @default(cuid())
  number         String      @unique
  leadId         String?
  tenantId       String?
  packageCode    PackageCode
  companyForm    CompanyForm @default(UG)
  /// [{ code, description, quantity, unitCents, recurring }]
  lines          Json
  oneTimeCents   Int
  monthlyCents   Int
  status         QuoteStatus @default(DRAFT)
  publicTokenHash String?    @unique
  priceListVersion String
  validUntil     DateTime
  sentAt         DateTime?
  acceptedAt     DateTime?
  acceptedByName String?
  acceptedIp     String?
  createdById    String?
  createdAt      DateTime    @default(now())

  lead           Lead?    @relation(fields: [leadId], references: [id])
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  contract       Contract?

  @@index([status, createdAt])
}

/// Çevrimiçi teklif onayı = hizmet sözleşmesi kaydı
model Contract {
  id           String   @id @default(cuid())
  tenantId     String
  quoteId      String   @unique
  termsVersion String
  signerName   String
  signerEmail  String
  signerIp     String?
  signedAt     DateTime @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote        Quote  @relation(fields: [quoteId], references: [id])

  @@index([tenantId])
}

model TenantContact {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Membership {
  id        String     @id @default(cuid())
  userId    String
  tenantId  String
  role      ClientRole
  createdAt DateTime   @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

/// Partner (ör. depo) kullanıcısının hizmet verdiği firmalar
model PartnerAssignment {
  id        String @id @default(cuid())
  userId    String
  tenantId  String

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

/// Ücretsiz uygunluk raporu / ön değerlendirme talebi
model Lead {
  id              String     @id @default(cuid())
  companyName     String
  email           String
  phone           String
  category        String
  status          LeadStatus @default(NEW)
  consentKvkk     Boolean
  marketingConsent Boolean   @default(false)
  attribution     Json       @default("{}")
  /// Müşteriye dönüşünce bağlanır
  tenantId        String?
  createdAt       DateTime   @default(now())

  notes           String?
  tenant          Tenant?    @relation(fields: [tenantId], references: [id])
  quotes          Quote[]

  @@index([status, createdAt])
}

model RegistrationTask {
  id        String           @id @default(cuid())
  tenantId  String
  step      RegistrationStep
  status    StepStatus       @default(BEKLIYOR)
  note      String?
  updatedAt DateTime         @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, step])
}

model Shipment {
  id         String        @id @default(cuid())
  tenantId   String
  reference  String
  stage      ShipmentStage @default(FABRIKA)
  pallets    Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reference])
  @@index([tenantId, stage])
}

model StockItem {
  id        String   @id @default(cuid())
  tenantId  String
  sku       String
  name      String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
}

/// Transactional outbox: olaylar aynı işlemde yazılır, worker işler
model OutboxEvent {
  id             String    @id @default(cuid())
  type           String
  tenantId       String?
  payload        Json
  idempotencyKey String    @unique
  attempts       Int       @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([processedAt, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  tenantId    String?
  action      String
  entity      String
  entityId    String?
  meta        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Tarih aralıklı fiyat listesi (varsayılan: packages/core/src/pricing.ts)
model PriceList {
  id        String    @id @default(cuid())
  version   String    @unique
  validFrom DateTime
  validTo   DateTime?
  data      Json
  createdAt DateTime  @default(now())
}

/// Çerez onay kaydı (kanıt yükümlülüğü). Kişisel veri yok: IP yalnız günlük tuzlu hash.
model ConsentRecord {
  id        String   @id @default(cuid())
  analytics Boolean
  ads       Boolean
  version   String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
